# 复制为 .env 后再启动。不要把 .env 提交进仓库。
# 容器里的监听地址由 docker-compose.yml 改写成 :8080 / :2525。
# 本机 `go run` 用下面这组，和 PUBLIC_BASE_URL 的端口一致。

HTTP_ADDR=:8787
SMTP_ADDR=:2525
SMTP_DOMAIN=localhost
PUBLIC_BASE_URL=http://127.0.0.1:8787

# 明文，或 bcrypt 哈希（$2a$ / $2b$ / $2y$）。
# 生成哈希：printf '%s' '你的密码' | go run ./cmd/hashpw
# 哈希含有 $。只通过 env_file 传入，不要写进 compose 的 ${ADMIN_PASSWORD}。
ADMIN_PASSWORD=please-change-this-password

RETENTION_DAYS=3
ATTACHMENT_MAX_BYTES=1048576
MESSAGE_MAX_BYTES=8388608

MAIL_DATA_DIR=./data
DATABASE_PATH=

# 只给「可选：自建 SMTP」的 A 记录用。推荐路径是 Cloudflare Email Routing，不使用这条。
# 203.0.113.10 是文档地址。自建收信前改成 VPS 的公网 IPv4。
SERVER_PUBLIC_IP=203.0.113.10

# 可选 STARTTLS。两个都填才启用，留空则只提供明文 SMTP。
SMTP_TLS_CERT=
SMTP_TLS_KEY=

# HTTP 收信。留空则 POST /ingest 不存在。
# 和 Cloudflare Worker 的 INGEST_TOKEN 用同一串。不要提交真值。
# 生成：openssl rand -base64 32
INGEST_TOKEN=
